{
  "Name": "fwd-objsto",
  "TaskTemplate": {
    "ContainerSpec": {
      "Image": "__IMAGE__",
      "Env": [
        "FWD_ADAM_APIKEY=/run/secrets/adam_api_key",
        "FWD_ADAM_BASEURI=https://wtiapi.vadc-test.bastille.cloud",
        "FWD_ADAM_SKIPVERIFY=true",
        "FWD_LOGGER_ENABLEDEBUG=true",
        "FWD_S3_ACCESSKEY=GKdf62cf3b0b0edb99e0eb138c",
        "FWD_S3_BUCKET=testbucket",
        "FWD_S3_HOST=container4:3900",
        "FWD_S3_REGION=testoregion",
        "FWD_S3_SCHEME=http",
        "FWD_S3_SECRETKEY=/run/secrets/s3_secret_key",
        "FWD_SENDER_PREFIX=events",
        "FWD_SERVER_PORT=3031",
        "FWD_SVC_DRYRUN=false",
        "FWD_SVC_ENRICH=false",
        "FWD_SVC_RAW=false",
        "FWD_SVC_REMOTE=true",
        "FWD_SVC_WEBHOOK=true",
        "FWD_WEBHOOK_BUFFERSIZE=99999",
        "FWD_WEBHOOK_BUFFERTYPES=audit_logs",
        "FWD_WEBHOOK_INTERVAL=99s"
      ],
      "Secrets": [
        {
          "SecretID": "__S3_SECRET_KEY_ID__",
          "SecretName": "__S3_SECRET_KEY_NAME__",
          "File": {
            "Name": "s3_secret_key",
            "UID": "1001",
            "GID": "1001",
            "Mode": 292
          }
        },
        {
          "SecretID": "__ADAM_API_KEY_ID__",
          "SecretName": "__ADAM_API_KEY_NAME__",
          "File": {
            "Name": "adam_api_key",
            "UID": "1001",
            "GID": "1001",
            "Mode": 292
          }
        }
      ],
      "Hosts": ["10.35.44.41 container4"],
      "ReadOnly": true,
      "User": "1001"
    },
    "LogDriver": {
      "Name": "json-file",
      "Options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "Resources": {
      "Limits": {
        "NanoCPUs": 500000000,
        "MemoryBytes": 134217728
      },
      "Reservations": {
        "NanoCPUs": 100000000,
        "MemoryBytes": 67108864
      }
    },
    "RestartPolicy": {
      "Condition": "on-failure",
      "Delay": 5000000000,
      "MaxAttempts": 3
    },
    "Networks": [
      {"Target": "svc-net"}
    ]
  },
  "Mode": {
    "Replicated": {
      "Replicas": 1
    }
  },
  "UpdateConfig": {
    "Order": "start-first",
    "FailureAction": "rollback"
  },
  "EndpointSpec": {
    "Ports": [
      {
        "Protocol": "tcp",
        "PublishedPort": 8011,
        "TargetPort": 3031
      }
    ]
  }
}
