#
# Copy to secret.env and replace secrets
# A-and "source" the file:
#
# zsh/bash: set -o allexport; source secret.env; set +o allexport
#

LGSCL_LOGGER_ENABLEDEBUG=True
LGSCL_CLIENT_BASEURI=https://bastille.ingest.logscale.us-2.crowdstrike.com
LGSCL_LOGSCALE_TOKEN=10239207-fb84-4837-b190-98b7a05e55c0
LGSCL_LOGSCALE_DRYRUN=True
LGSCL_WEBHOOK_INTERVAL=6s
LGSCL_SERVER_PORT=3030

# Try not to check in secrets!
#
#KEY                         TYPE             DEFAULT    REQUIRED    DESCRIPTION
#LGSCL_LOGGER_MAXLEN         Integer          999                    maximum length that will be logged for any field
#LGSCL_LOGGER_ENABLEDEBUG    True or False    false                  log debug messages
#LGSCL_LOGGER_ENABLETRACE    True or False    false                  log trace messages
#LGSCL_LOGSCALE_URL          String                      true        logscale ingestion url
#LGSCL_LOGSCALE_TOKEN        String                      true        logscale ingestion token
#LGSCL_LOGSCALE_DRYRUN       True or False    false                  skip updates to logscale
#LGSCL_WEBHOOK_INTERVAL      Duration         60s                    period to process buffered events
#LGSCL_WEBHOOK_BUFFERSIZE    Integer          999                    size of event buffer
#LGSCL_SERVER_HOST           String                                  hostname or ip for which to bind
#LGSCL_SERVER_PORT           Integer                     true        port on which to listen
#LGSCL_SERVER_TIMEOUT        Duration         10s                    characteristic timeout
